.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.env.local
*.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets and credentials
*credentials*
*secrets*
*token*
*.json

# Config files with secrets
configs/config.yaml
configs/*.local
configs/*.json

# Data files (keep structure, ignore actual data for privacy)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Reports and figures (generated)
reports/figures/*
!reports/figures/.gitkeep
reports/*.html
reports/*.pdf

# Logs
*.log
logs/
